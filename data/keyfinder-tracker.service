# Switched by the app: runs exactly when at least one tag has "Remember
# location" on. Do not enable it by hand – the next change in the app or the
# next update restores the state.
[Unit]
Description=Key Finder: remember where tags were last seen
After=dbus.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/keyfinder --tracker
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
